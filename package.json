{
  "name": "uplift",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @uplift/shared build && pnpm --parallel --filter @uplift/shared --filter web --filter api dev",
    "build": "pnpm --filter @uplift/shared build && pnpm -r --filter !@uplift/shared build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  }
}
